---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<ul class="socials">
	{
		site.socials.map((s) => (
			<li>
				<a href={s.href} aria-label={s.label} title={s.label}>
					<Icon name={s.icon} />
				</a>
			</li>
		))
	}
</ul>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		border: 1px solid var(--border);
		color: var(--text);
		transition: color 0.15s, border-color 0.15s;
	}

	a:hover {
		color: var(--gold-bright);
		border-color: var(--gold);
	}
</style>
