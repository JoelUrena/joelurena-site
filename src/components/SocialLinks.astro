---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<ul class="socials">
	{
		site.socials.map((s) => (
			<li>
				<a class="angular" href={s.href} aria-label={s.label} title={s.label}>
					<Icon name={s.icon} />
				</a>
			</li>
		))
	}
</ul>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Angular tile: the shape comes from .angular in global.css. */
	a {
		--cut: 0.45rem;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--text);
	}

	a:hover {
		--fill: var(--silver);
		color: #000;
	}
</style>
