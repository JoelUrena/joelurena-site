---
// Click-to-play YouTube embed. Until someone presses play, the page only loads our own
// optimized poster image, not YouTube's ~600 KB player. Without JavaScript it's a plain
// link to the video on YouTube.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	id: string;
	title: string;
	poster: ImageMetadata;
	/** Load the poster eagerly (use for the first video on a page). */
	priority?: boolean;
	sizes?: string;
}

const { id, title, poster, priority = false, sizes = '(min-width: 72rem) 70rem, 100vw' } = Astro.props;
---

<div class="yt">
	<a class="yt-link" href={`https://www.youtube.com/watch?v=${id}`} data-yt-id={id} data-yt-title={title}>
		<Picture
			src={poster}
			alt=""
			formats={['avif', 'webp']}
			widths={[480, 800, 1280]}
			sizes={sizes}
			loading={priority ? 'eager' : 'lazy'}
			fetchpriority={priority ? 'high' : 'auto'}
		/>
		<span class="yt-play" aria-hidden="true">
			<svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#e00"></path><path d="M45 24 27 14v20" fill="#fff"></path></svg>
		</span>
		<span class="visually-hidden">Play video: {title}</span>
	</a>
</div>

<script>
	document.querySelectorAll<HTMLAnchorElement>('a[data-yt-id]').forEach((link) => {
		link.addEventListener('click', (event) => {
			if (event.metaKey || event.ctrlKey || event.shiftKey) return;
			event.preventDefault();
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.ytId}?autoplay=1&rel=0`;
			iframe.title = link.dataset.ytTitle ?? 'YouTube video';
			iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			iframe.allowFullscreen = true;
			link.replaceWith(iframe);
			iframe.focus();
		});
	});
</script>

<style>
	.yt {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #000;
		border-radius: var(--radius);
		overflow: hidden;
	}

	.yt-link,
	.yt :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.yt-link :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: filter 0.2s;
	}

	.yt-play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		opacity: 0.88;
		transition: opacity 0.2s, transform 0.2s;
	}

	.yt-link:hover .yt-play,
	.yt-link:focus-visible .yt-play {
		opacity: 1;
		transform: scale(1.08);
	}

	.yt-link:hover :global(img) {
		filter: brightness(0.8);
	}

	.yt-link:focus-visible {
		outline-offset: -4px;
	}
</style>
