---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { legacyRedirects } from '../data/legacy.mjs';

// Case-insensitive lookup for old links typed with odd capitalisation (/Jufi, /Videos.html…),
// plus the old non-HTML URLs in legacyRedirects, like the résumé PDFs (GitHub Pages serves this page for those).
// Exact-case old pages never get here: they have their own redirect pages.
const lookup = Object.fromEntries(
	Object.entries(legacyRedirects).map(([file, target]) => [file.replace(/\.html$/, '').toLowerCase(), target]),
);
---

<Base title="Page not found – Joel Ureña" description="This page doesn’t exist." noindex>
	<script is:inline slot="head" define:vars={{ lookup }}>
		const path = decodeURIComponent(location.pathname)
			.replace(/^\/+|\/+$/g, '')
			.replace(/\.html$/i, '')
			.toLowerCase();
		const target = Object.hasOwn(lookup, path) ? lookup[path] : undefined;
		// Never redirect to the URL we're already on (that would loop).
		if (target && decodeURIComponent(target) !== decodeURIComponent(location.pathname)) {
			location.replace(target + location.hash);
		} else if (location.pathname !== location.pathname.toLowerCase()) {
			// Every page on the new site has a lowercase URL.
			location.replace(location.pathname.toLowerCase() + location.search + location.hash);
		}
	</script>
	<main id="main" class="section container">
		<p class="eyebrow">404</p>
		<h1>This page doesn’t exist</h1>
		<p class="lede">It may have moved when the site was rebuilt. Try one of these instead:</p>
		<ul>
			<li><a href="/">Home</a></li>
			<li><a href="/jufi/">JUFI films</a></li>
			<li><a href="/jufi/videos/">All videos</a></li>
		</ul>
	</main>
	<Footer />
</Base>
