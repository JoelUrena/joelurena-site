---
import Base from '../../../layouts/Base.astro';
import JufiHeader from '../../../components/JufiHeader.astro';
import Footer from '../../../components/Footer.astro';
import VideoCard from '../../../components/VideoCard.astro';
import { topVideos, videos } from '../../../data/videos';
---

<Base
	title="All videos – JUFI"
	description={`All ${videos.length} JUFI films by Joel Ureña, from 2016 to 2020: a documentary, scene replications, competition films and class projects.`}
>
	<JufiHeader />
	<main id="main">
		<section class="section container" aria-labelledby="top-title">
			<h1 class="eyebrow">All JUFI videos</h1>
			<h2 id="top-title" class="section-title">Top films</h2>
			<div class="grid">
				{topVideos.map((video, i) => <VideoCard video={video} priority={i < 4} />)}
			</div>
		</section>

		<section class="section container all" aria-labelledby="all-title">
			<h2 id="all-title" class="section-title">All JUFI films</h2>
			<p class="lede">All the films I made, from most recent to oldest. Some are unfinished projects, but they’re watchable.</p>
			<div class="grid">
				{videos.map((video) => <VideoCard video={video} />)}
			</div>
		</section>
	</main>
	<Footer />
</Base>

<style>
	.section-title {
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		font-weight: 700;
	}

	.all {
		padding-top: 0;
	}

	.grid {
		margin-top: 1.5rem;
	}
</style>
