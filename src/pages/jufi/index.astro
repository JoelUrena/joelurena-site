---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import JufiHeader from '../../components/JufiHeader.astro';
import Footer from '../../components/Footer.astro';
import VideoCard from '../../components/VideoCard.astro';
import YouTube from '../../components/YouTube.astro';
import { notableVideos, videos } from '../../data/videos';
import introFirst from '../../assets/brand/jufi-intro-first.png';
import introLast from '../../assets/brand/jufi-intro-last.png';

const reel = videos.find((v) => v.slug === 'film-reel')!;
const firstFrame = await getImage({ src: introFirst, format: 'webp', width: 1148 });
const titleFrame = await getImage({ src: introLast, format: 'webp', width: 1148 });
const socialImage = await getImage({ src: introLast, format: 'jpeg', width: 1200, height: 630, fit: 'cover' });
---

<Base
	title="JUFI – Joel Ureña Films Incorporated"
	description="Short films, a documentary and class projects by Joel Ureña, 2016–2020, including a documentary made with HBO and a film in the Museum of the Moving Image’s Jim Henson exhibit."
	image={socialImage.src}
>
	<JufiHeader />
	<main id="main">
		<h1 class="visually-hidden">JUFI – Joel Ureña Films Incorporated</h1>

		<section class="container hero" aria-label="Welcome to JUFI">
			<!-- The logo animation plays once and holds on its last frame, the "JUFI – Joel Urena Films
			     Incorporated" title, like the original GIF (which had no loop). The title frame is the default
			     poster, so it's what shows without JavaScript, with reduced motion, or if the browser blocks
			     autoplay; the script below starts the animation only when it can play. -->
			<video
				id="jufi-intro"
				class="logo"
				muted
				playsinline
				preload="none"
				width="1148"
				height="800"
				poster={titleFrame.src}
				data-first-frame={firstFrame.src}
				aria-hidden="true"
			>
				<source src="/media/jufi-intro.av1.webm" type='video/webm; codecs="av01.0.05M.08"' />
				<source src="/media/jufi-intro.webm" type='video/webm; codecs="vp9"' />
				<source src="/media/jufi-intro.mp4" type="video/mp4" />
			</video>
			<script is:inline>
				(() => {
					const video = document.getElementById('jufi-intro');
					if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					const titlePoster = video.poster;
					const showTitle = () => {
						video.querySelectorAll('source').forEach((s) => s.remove());
						video.poster = titlePoster;
						video.load();
					};
					video.poster = video.dataset.firstFrame;
					video.preload = 'auto';
					// Blocked autoplay rejects play(); if every source fails, the last one fires 'error'.
					video.querySelector('source:last-of-type').addEventListener('error', showTitle);
					video.play().catch(showTitle);
				})();
			</script>
			<YouTube
				id={reel.youtubeId!}
				title="Welcome to JUFI – Film Reel"
				poster={reel.thumbnail}
				priority
				sizes="(min-width: 60rem) 34rem, 100vw"
			/>
		</section>

		<hr class="rule" />

		<section class="section container" aria-labelledby="notable-title">
			<h2 id="notable-title">Notable films</h2>
			<p class="lede">My most recent and notable films that I’ve worked on.</p>
			<div class="grid notable">
				{notableVideos.map((video) => <VideoCard video={video} excerpt />)}
			</div>
			<p class="more">
				<a class="button primary" href="/jufi/videos/">Browse all {videos.length} videos</a>
			</p>
		</section>
	</main>
	<Footer />
</Base>

<style>
	.hero {
		display: grid;
		gap: 1.5rem;
		padding-block: clamp(2rem, 6vw, 4rem);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
		align-items: center;
	}

	.logo {
		width: 100%;
		aspect-ratio: 1148 / 800;
		object-fit: contain;
		background: #000;
	}

	/* Full-width white line between the hero and the films, as on the 2020 page. */
	.rule {
		height: 3px;
		margin: 0;
		border: 0;
		background: var(--text);
	}

	.notable {
		margin-top: 1.5rem;
	}

	.more {
		margin-top: 2.5rem;
	}
</style>
